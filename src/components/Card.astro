---
import type { CardData } from "../data/board";

interface Props {
  card: CardData;
}

const { card } = Astro.props;
const labelClass = "mt-3 text-[11.5px] font-bold uppercase tracking-[.07em] text-accent";
const textClass = "mt-[3px] text-[14.5px] text-muted";
---

<details class:list={["card", { "card-next": card.kind === "next" }]}>
  <summary class="block px-3.5 pt-3.5 pb-3">
    <span class="mb-1.5 flex items-center justify-between font-mono text-xs font-medium text-muted">
      {card.kind === "shipped" && <span>{card.id}</span>}
      {
        card.kind === "running" && (
          <span class="inline-flex items-center gap-1.5 text-accent-ink">
            <span class="live-dot size-2 rounded-full bg-accent" aria-hidden="true" />
            Runs nightly
          </span>
        )
      }
      {
        card.kind === "next" && (
          <span class="rounded-[5px] bg-hyp-bg px-1.5 py-1 text-[11px] leading-none font-semibold tracking-[.06em] text-hyp uppercase">
            Hypothesis
          </span>
        )
      }
      <span
        class="toggle grid size-[22px] place-items-center rounded-md border border-line font-sans text-[15px] leading-none font-medium text-ink"
        aria-hidden="true"></span>
    </span>
    <span class="block font-serif text-[17.5px] leading-[1.3] font-semibold">{card.title}</span>
    <span class="mt-[5px] block text-[14.5px]">{card.face}</span>
    <span class="mt-2.5 flex flex-wrap gap-1.5">
      {
        card.tags.map((tag) => (
          <span class="rounded-[5px] bg-tint px-[7px] py-[5px] font-mono text-[11.5px] leading-none font-medium text-accent-ink">
            {tag}
          </span>
        ))
      }
    </span>
  </summary>
  {
    card.kind === "shipped" ? (
      <dl class="mx-3.5 border-t border-dashed border-line pt-0.5 pb-3.5">
        <dt class={labelClass}>Problem</dt>
        <dd class={textClass}>{card.problem}</dd>
        <dt class={labelClass}>What I built</dt>
        <dd class={textClass}>{card.built}</dd>
        {card.result && (
          <>
            <dt class={labelClass}>Result</dt>
            <dd class={textClass}>{card.result}</dd>
          </>
        )}
      </dl>
    ) : (
      <div class="mx-3.5 border-t border-dashed border-line pt-0.5 pb-3.5">
        <p class="mt-3 text-[14.5px] text-muted">{card.detail}</p>
      </div>
    )
  }
</details>
